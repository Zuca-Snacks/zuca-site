    "dev": "vite",
    "lint": "eslint .",
    "mutate": "node scripts/mutate.mjs",
    "preview": "vite preview",
    "security:columns": "node scripts/sheet-columns.mjs",
    "security:columns:check": "node scripts/sheet-columns.mjs --check",
    "security:compat": "node scripts/check-merge-compat.mjs",
    "security:headers": "node scripts/check-headers.mjs",
    "security:livewrite": "node scripts/live-write-test.mjs",
    "security:mutate": "node scripts/mutate-compat.mjs",
    "security:repeat": "node scripts/simulate-repeat-signup.mjs no-secret && node scripts/simulate-repeat-signup.mjs with-secret",
